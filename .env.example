# Copy to `.env.local` and fill in your own values.
# NEVER commit .env.local.

# Dashboard -> Account & Settings -> API Keys -> Generate Test Key
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Safe to expose - Razorpay Checkout needs it in the browser.
# Keep identical to RAZORPAY_KEY_ID.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID

# Webhook secret and REFUND_API_SECRET are NOT used by this starter.
# They belong to the paid kit, which adds webhook verification.
